### an initial network
container
create
--cidfile=/var/lib/dokku/services/redis/lollipop/ID
--env-file=/var/lib/dokku/services/redis/lollipop/ENV
--hostname=dokku.redis.lollipop
--label=dokku.service=redis
--label=dokku=service
--name=dokku.redis.lollipop
--restart=always
--volume=/var/lib/dokku/services/redis/lollipop/config:/usr/local/etc/redis
--volume=/var/lib/dokku/services/redis/lollipop/data:/data
--network=custom-network
--network-alias=dokku-redis-lollipop
redis:8.8.0
redis-server
/usr/local/etc/redis/redis.conf
--bind
0.0.0.0

